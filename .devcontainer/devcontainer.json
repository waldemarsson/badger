// .devcontainer/devcontainer.json
{
  "name": "TimeTracker (Tauri + SvelteKit)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
  },
  // ======================== Features ========================
  "features": {
    // Rust toolchain via rustup
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "default",
    },
    // Node.js — SvelteKit frontend + required runtime for Claude Code and Copilot CLI
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
    },
    // Claude Code — Anthropic's AI coding CLI
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // GitHub Copilot CLI
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
  },
  // Node.js must install before Claude Code and Copilot CLI (both npm-based).
  // Rust first so cargo is available to any subsequent steps.
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/rust",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code",
    "ghcr.io/devcontainers/features/copilot-cli",
  ],
  // ======================== Filesystem ========================
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    // Named volumes for build caches — persist across rebuilds
    {
      "source": "devcontainer-cargo-${devcontainerId}",
      "target": "/home/vscode/.cargo/registry",
      "type": "volume",
    },
    {
      "source": "devcontainer-npm-${devcontainerId}",
      "target": "/home/vscode/.npm",
      "type": "volume",
    },
    {
      "source": "devcontainer-claude-config-${devcontainerId}",
      "target": "/home/vscode/.claude",
      "type": "volume",
    },
    // Bind-mount Copilot skills and agents so host and container stay in sync.
    // Run once on your Mac before first open:
    //   mkdir -p ~/.copilot/skills ~/.copilot/agents ~/.agents/skills
    {
      "source": "${localEnv:HOME}/.copilot/skills",
      "target": "/home/vscode/.copilot/skills",
      "type": "bind",
    },
    {
      "source": "${localEnv:HOME}/.copilot/agents",
      "target": "/home/vscode/.copilot/agents",
      "type": "bind",
    },
    {
      "source": "${localEnv:HOME}/.agents/skills",
      "target": "/home/vscode/.agents/skills",
      "type": "bind",
    },
  ],
  // ======================== Runtime ========================
  "remoteUser": "vscode",
  "containerEnv": {
    // Claude
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // GitHub Copilot
    "COPILOT_GITHUB_TOKEN": "${localEnv:COPILOT_GITHUB_TOKEN}",
  },
  // ======================== VS Code Extensions ========================
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "rust-lang.rust-analyzer",
        "svelte.svelte-vscode",
        "tauri-apps.tauri-vscode",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
        },
        "rust-analyzer.cargo.buildScripts.enable": true,
      },
    },
  },
  // ======================== Lifecycle ========================
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  // ======================== Host Requirements ========================
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb",
  },
}
