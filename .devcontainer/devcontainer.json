// .devcontainer/devcontainer.json
{
  "name": ".NET DevContainer (AI + DinD)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
  },
  // ======================== Features ========================
  "features": {
    // Docker-in-Docker — full isolated dockerd.
    // "moby": true is REQUIRED to avoid TestContainers .NET NullReferenceException.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "version": "latest",
      "enableNonRootDocker": true,
      "installDockerBuildx": true,
      "dockerDashComposeVersion": "v2",
    },
    // Node.js — required runtime for both Claude Code and Copilot CLI
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
    },
    // Claude Code — Anthropic's AI coding CLI
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // GitHub Copilot CLI — official devcontainers feature
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    //"ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
    //    "packages": "openssh-server,openjdk-21-jre"
    //}
  },
  // Node.js must install before Claude Code and Copilot CLI (both npm-based).
  // DinD last — it hooks the container entrypoint to start dockerd.
  "overrideFeatureInstallOrder": [
    "ghcr.io/rocker-org/devcontainer-features/apt-packages",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code",
    "ghcr.io/devcontainers/features/copilot-cli",
    "ghcr.io/devcontainers/features/docker-in-docker",
  ],
  // ======================== Filesystem Isolation ========================
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    // Named volumes for caches — persist across rebuilds, no host filesystem exposure
    {
      "source": "devcontainer-nuget-${devcontainerId}",
      "target": "/home/vscode/.nuget",
      "type": "volume",
    },
    {
      "source": "devcontainer-credprovider-${devcontainerId}",
      "target": "/home/vscode/.local/share/MicrosoftCredentialProvider",
      "type": "volume",
    },
    {
      "source": "devcontainer-claude-config-${devcontainerId}",
      "target": "/home/vscode/.claude",
      "type": "volume",
    },
    // Bind-mount the full Copilot state directory so host and container use the
    // same skills, plugins, config, logs, DBs, and future files without needing
    // per-subdirectory mounts.
    // Run once on your Mac before first open:
    //   mkdir -p ~/.copilot ~/.agents/skills
    {
        "source": "${localEnv:HOME}/.copilot",
        "target": "/home/vscode/.copilot",
        "type": "bind"
    },
    {
        "source": "${localEnv:HOME}/.agents/skills",
        "target": "/home/vscode/.agents/skills",
        "type": "bind"
    },
    // Secrets file — bind-mounted read-only so postCreate.sh can distribute
    // secrets without ever passing them as Docker env vars (-e flags).
    {
      "source": "${localWorkspaceFolder}/.devcontainer/.env",
      "target": "/run/secrets/dev.env",
      "type": "bind",
    },
  ],
  // ======================== Runtime ========================
  "init": true,
  "remoteUser": "vscode",
  "containerEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "NUGET_CREDENTIALPROVIDER_SESSIONTOKENCACHE_ENABLED": "true",
    // Claude
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Github Copilot
    "COPILOT_GITHUB_TOKEN": "${localEnv:COPILOT_GITHUB_TOKEN}",
    // ── Azure PAT (non-interactive) ─────────────────────────────────────
    // Uncomment and set AZURE_ARTIFACTS_PAT on your Mac to skip device-code login:
    "ARTIFACTS_CREDENTIALPROVIDER_EXTERNAL_FEED_ENDPOINTS": "{\"endpointCredentials\":[{\"endpoint\":\"https://pkgs.dev.azure.com/roxtecinternational/_packaging/roxtecinternational/nuget/v3/index.json\",\"username\":\"az\",\"password\":\"${localEnv:AZURE_ARTIFACTS_PAT}\"}]}",
  },
  // ======================== VS Code Extensions ========================
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot", // inline suggestions (include during 2025-26 consolidation)
        "GitHub.copilot-chat", // chat + agents — will absorb inline in 2026
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker",
      ],
      "settings": {
        "dotnet.defaultSolution": "disable",
      },
    },
    "jetbrains": {
      "backend": "Rider",
    },
  },
  // ======================== Lifecycle ========================
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  // ======================== Host Requirements ========================
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb",
  },
}
